{
  "name": "@action-studio/editor-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:embed": "esbuild src/embed/index.ts --bundle --format=iife --platform=browser --minify --outfile=public/embed.js",
    "dev": "npm run build:embed && next dev",
    "build": "npm run build:embed && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@action-studio/editor-engine": "file:../engine",
    "@vercel/blob": "^0.27.0",
    "bcryptjs": "^2.4.3",
    "next": "14.2.15",
    "pg": "^8.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.16.10",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.11",
    "esbuild": "^0.24.2",
    "jsdom": "^25.0.1",
    "pg-mem": "^3.0.5",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
