# Action Studio — Website Factory environment
# Copy this file to .env and fill in each value. The factory will fail-fast at run start
# if any of the REQUIRED variables below are missing.
#
# Where each variable is used is annotated by the SOP / skill that reads it.

# ─── REQUIRED ────────────────────────────────────────────────────────

# Google Places API key — used by skills/review-scraper/
# Get one: https://console.cloud.google.com → APIs & Services → Credentials
# Enable: Places API (New)
GOOGLE_PLACES_API_KEY=

# Vercel deployment — used by skills/deploy-vercel/ (SOP 14)
# Token: https://vercel.com/account/tokens
# Team ID: vercel teams ls --token=$VERCEL_TOKEN
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# ─── REQUIRED if you want AI-generated mascots ───────────────────────
# Used by skills/ai-image-generator/ (SOP 09). Only fires if assets/raw/mascot.* is missing
# AND the design-director decides the archetype needs one.
# Pick one provider:

# Option A: OpenAI Images (DALL-E 3)
OPENAI_API_KEY=

# Option B: Replicate (FLUX, Stable Diffusion)
# REPLICATE_API_TOKEN=

# ─── REQUIRED if you want real Facebook reviews ──────────────────────
# Facebook page review access requires app review + Page access tokens.
# Most operators get by on Google Places reviews alone (count >= 10 there usually clears the gate).
# If you set this, it's used by skills/review-scraper/.
# FB_PAGE_ACCESS_TOKEN=

# ─── REQUIRED if you want paid keyword data ──────────────────────────
# skills/seo-keyword-tool/ — pick one (DataForSEO recommended for accuracy):

# Option A: DataForSEO
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=

# Option B: SerpAPI (free tier, less data)
# SERPAPI_KEY=

# ─── OPTIONAL ────────────────────────────────────────────────────────

# Contact form webhook — default endpoint for every contractor's contact form
# unless the recipe or brief.md overrides. Use Formspree, Make, n8n, or a custom webhook.
DEFAULT_CONTACT_FORM_ENDPOINT=

# Where to email completion summaries (optional)
# OPS_NOTIFICATION_EMAIL=

# Whether to run in dry-run mode (skip the deploy phase, write deploy/dry-run.md instead)
# DRY_RUN=false
