<!-- ================= FAQ ================= -->
<section id="faq" class="py-20 bg-navy diag">
  <div class="max-w-[820px] mx-auto px-6 text-center">
    <p class="text-[11px] tracking-[0.32em] gold-text font-bold mb-4">{{faq_kicker}}</p>
    <h2 class="font-heading heading-metallic text-4xl md:text-5xl leading-[1.05] tracking-wide">{{faq_h2}}</h2>
  </div>
  <div class="max-w-[820px] mx-auto px-6 mt-10 space-y-3">
    {{#loop:faq}}
      <details class="bg-card border border-white/10">
        <summary class="flex items-center justify-between gap-4 px-6 py-4 cursor-pointer">
          <span class="text-xs font-bold tracking-wide text-left">{{item.q}}</span>
          <span class="faq-icon gold-text text-lg transition-transform">+</span>
        </summary>
        <p class="px-6 pb-5 text-xs text-white/55 leading-relaxed">
          {{item.a}}
        </p>
      </details>
    {{/loop:faq}}
  </div>
</section>
