<!-- ================= REVIEWS ================= -->
<section id="reviews" class="relative py-20 bg-navy diag">
  <div class="max-w-7xl mx-auto px-6 text-center">
    <p class="text-[11px] tracking-[0.32em] gold-text font-bold mb-4">{{reviews_kicker}}</p>
    <h2 class="font-heading heading-metallic text-4xl md:text-5xl leading-[1.05] tracking-wide max-w-3xl mx-auto">
      {{reviews_h2}}
    </h2>
    <p class="mt-5 text-sm text-white/55 max-w-2xl mx-auto leading-relaxed">
      {{reviews_intro}}
    </p>

    <!-- Glass review badges -->
    <div class="mt-7 flex flex-wrap justify-center gap-3">
      <a href="{{google_reviews_url}}" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 px-4 py-2 transition-all hover:border-[{{brand.color.accent}}]" style="background: rgba(255,255,255,0.09); border: 1px solid rgba(255,255,255,0.16); backdrop-filter: blur(10px);">
        <svg class="w-6 h-6 flex-shrink-0" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"></path><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"></path><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"></path><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"></path></svg>
        <div class="text-left">
          <div class="flex items-center gap-1">
            <span class="font-bold text-sm text-white">{{google_rating}}</span>
            <div class="flex text-yellow-400 text-sm leading-none">★★★★★</div>
            <span class="text-white/50 text-[11px]">({{google_count}})</span>
          </div>
          <div class="text-[11px] text-white/55 leading-none">See all Google Reviews</div>
        </div>
      </a>
      <a href="{{facebook_reviews_url}}" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 px-4 py-2 transition-all hover:border-[{{brand.color.accent}}]" style="background: rgba(255,255,255,0.09); border: 1px solid rgba(255,255,255,0.16); backdrop-filter: blur(10px);">
        <svg class="w-6 h-6 flex-shrink-0" viewBox="0 0 24 24"><path fill="#1877F2" d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07c0 6.02 4.39 11.01 10.13 11.93v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.69.24 2.69.24v2.97h-1.51c-1.49 0-1.96.93-1.96 1.89v2.25h3.33l-.53 3.49h-2.8v8.44C19.61 23.08 24 18.09 24 12.07z"></path></svg>
        <div class="text-left">
          <div class="flex items-center gap-1">
            <span class="font-bold text-sm text-white">{{facebook_rating}}</span>
            <div class="flex text-yellow-400 text-sm leading-none">★★★★★</div>
            <span class="text-white/50 text-[11px]">({{facebook_count}})</span>
          </div>
          <div class="text-[11px] text-white/55 leading-none">See all Facebook Reviews</div>
        </div>
      </a>
    </div>

    <!-- Review cards -->
    <div class="mt-12 grid md:grid-cols-3 gap-6 text-left">
      {{#loop:reviews,N=6}}
        <div class="bg-card border border-white/10 p-6">
          <div class="flex items-center gap-3">
            <img src="{{item.avatar}}" alt="" class="w-12 h-12 rounded-full object-cover" />
            <div>
              <div class="font-bold text-sm">{{item.author}}</div>
              <div class="text-yellow-400 text-xs">{{item.stars}}</div>
            </div>
          </div>
          <p class="mt-4 text-xs text-white/55 leading-relaxed">
            "{{item.text}}"
          </p>
          <div class="mt-4 text-[10px] text-white/35 font-semibold tracking-wide">VERIFIED {{item.platform}} REVIEW</div>
        </div>
      {{/loop:reviews}}
    </div>
    <div class="mt-8 flex justify-center gap-2">
      <span class="w-2 h-2 rounded-full bg-gold"></span>
      <span class="w-2 h-2 rounded-full bg-white/15"></span>
      <span class="w-2 h-2 rounded-full bg-white/15"></span>
    </div>
  </div>
</section>
