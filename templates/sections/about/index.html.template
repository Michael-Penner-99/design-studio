<!-- ================= ABOUT ================= -->
<section id="about" class="py-20 bg-navy-2 diag">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid lg:grid-cols-2 gap-14 items-center">
      <div>
        <p class="text-[11px] tracking-[0.32em] gold-text font-bold mb-4">{{about_kicker}}</p>
        <h2 class="font-heading heading-metallic text-4xl md:text-5xl leading-[1.05] tracking-wide">
          {{about_h2}}
        </h2>
        <p class="mt-5 text-sm text-white/55 leading-relaxed">
          {{about_body_1}}
        </p>
        <p class="mt-4 text-sm text-white/55 leading-relaxed">
          {{about_body_2}}
        </p>
        <a href="/about.html" class="mt-7 inline-flex items-center gap-2 btn-gold font-body font-bold text-[11px] uppercase tracking-wider px-6 py-3.5">
          {{about_cta_label}}
        </a>
      </div>
      <div class="relative">
        <img src="{{asset:owner}}" alt="{{about_image_alt}}" class="w-full h-[480px] object-cover" />
        <div class="absolute -bottom-5 -left-5 btn-gold px-6 py-4 text-center shadow-xl">
          <div class="font-heading text-4xl leading-none">{{about_stat_number}}</div>
          <div class="text-[9px] font-bold tracking-widest mt-1">{{about_stat_label}}</div>
        </div>
      </div>
    </div>

    <div class="mt-16 grid md:grid-cols-2 gap-6">
      <div class="bg-card border border-white/10 p-7">
        <div class="flex items-center gap-3 mb-3">
          <span class="w-10 h-10 bg-gold/15 gold-text flex items-center justify-center text-lg">&#9678;</span>
          <h3 class="font-heading text-xl tracking-wide">{{vision_h3}}</h3>
        </div>
        <p class="text-xs text-white/55 leading-relaxed">
          {{vision_body}}
        </p>
      </div>
      <div class="bg-card border border-white/10 p-7">
        <div class="flex items-center gap-3 mb-3">
          <span class="w-10 h-10 bg-gold/15 gold-text flex items-center justify-center text-lg">&#10022;</span>
          <h3 class="font-heading text-xl tracking-wide">{{mission_h3}}</h3>
        </div>
        <p class="text-xs text-white/55 leading-relaxed">
          {{mission_body}}
        </p>
      </div>
    </div>
  </div>
</section>
