<!doctype html>
<!--
  templates/walkthrough/walkthrough.html.template

  Sales walkthrough page. Generated by the proposal-writer agent (SOP 13) and
  deployed as a separate Vercel project at {slug}-sales.actiondesignstudio.com
  in Phase 8 (SOP 14).

  Light theme (NOT the dark contractor-site theme). Cream background, red-orange
  CTAs, Inter + Space Grotesk type pairing. Matches the King Contractor Agency
  reference screenshot the operator shared.

  TOKENS (single-curly-brace per existing convention):
    {{contractor_brand_name}}          header right-side label, hero, pricing copy
    {{contractor_logo_path}}           contractor logo file (relative path inside sales/)
    {{prepared_date}}                  e.g. "May 18, 2026"
    {{opportunity_summary}}            2-3 sentence pull from research/competitors.md
    {{primary_keyword}}                e.g. "Kansas City HVAC"
    {{review_count}}                   integer
    {{review_rating}}                  float, e.g. 4.8
    {{photo_count}}                    integer
    {{old_site_score}}                 0-120 from research/site-scorecard.md
    {{new_site_score}}                 0-120 of the built site
    {{site_preview_url}}               https://{slug}.actiondesignstudio.com
    {{calendar_url}}                   default: mailto:hello@actiondesignstudio.com
    {{standard_tier_price}}            e.g. "$5,000"
    {{pro_tier_price}}                 e.g. "$15,000"

  CONDITIONALS (templating extension — documented in docs/architecture.md §3):
    {{#if_mode_name_and_reviews}}...{{/if_mode_name_and_reviews}}
      Render block only when brief.md frontmatter has `_meta.mode: name-and-reviews`.
    {{#if_mode_url}}...{{/if_mode_url}}
      Render block only when brief.md frontmatter has `_meta.mode: url` (default).
    {{#if_pro_tier}}...{{/if_pro_tier}}
      Render block only when the run was triggered with pro_tier=true.
    {{#if_standard_tier}}...{{/if_standard_tier}}
      Render block only when the run is standard tier (default).

  The build phase already supports {{token}}, {{asset:name}}, {{section:name}},
  {{#loop:name}}. The if_* conditionals are a new addition — SOP 13 documents
  the resolver behavior.
-->
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{contractor_brand_name}} — Your Website Walkthrough · Action Studio</title>
  <meta name="robots" content="noindex,nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            cream: '#F7F2EA',
            'cream-2': '#EFE7D8',
            ink: '#0A0A0A',
            'ink-soft': '#1F1F1F',
            'ink-mute': '#5C5C5C',
            'as-red': '#E63312',
            'as-red-2': '#FF4D2E',
            'as-gold': '#E9B547'
          },
          fontFamily: {
            body: ['Inter', 'system-ui', 'sans-serif'],
            heading: ['"Space Grotesk"', 'Inter', 'system-ui', 'sans-serif']
          }
        }
      }
    }
  </script>
  <style>
    html, body { background: #F7F2EA; color: #0A0A0A; font-family: 'Inter', system-ui, sans-serif; }
    .font-heading { font-family: 'Space Grotesk', Inter, system-ui, sans-serif; letter-spacing: -0.01em; }
    .cta-red {
      background: linear-gradient(135deg, #FF4D2E, #E63312);
      color: #fff;
      box-shadow: 0 12px 28px -10px rgba(230,51,18,0.55), inset 0 1px 0 rgba(255,255,255,0.22);
    }
    .cta-red:hover { filter: brightness(1.04); transform: translateY(-1px); }
    .cta-red:active { transform: translateY(0); }
    .num-display {
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 700;
      letter-spacing: -0.04em;
      background: linear-gradient(135deg, #FF4D2E 0%, #E63312 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
    .lever-card {
      background: #FFFDF8;
      border: 1px solid #E7DECD;
      border-radius: 14px;
      transition: transform 220ms ease, box-shadow 220ms ease;
    }
    .lever-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 24px 40px -22px rgba(10,10,10,0.18);
    }
    details > summary { list-style: none; cursor: pointer; }
    details > summary::-webkit-details-marker { display: none; }
    details[open] summary .how-chev { transform: rotate(180deg); }
    .how-chev { transition: transform 220ms ease; }
    .banner-ai {
      background: linear-gradient(90deg, #FFF1D6, #FFE7C4);
      border: 1px solid #E9C786;
      color: #6B4A0F;
    }
    .pill {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 4px 10px; border-radius: 999px;
      font-size: 11px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase;
      background: #FFFDF8; border: 1px solid #E7DECD; color: #5C5C5C;
    }
    .check-dot {
      width: 22px; height: 22px; border-radius: 999px;
      background: linear-gradient(135deg, #FF4D2E, #E63312);
      color: #fff; display: inline-flex; align-items: center; justify-content: center;
      font-size: 12px; font-weight: 700; flex-shrink: 0;
    }
    .tier-card {
      background: #FFFDF8;
      border: 1px solid #E7DECD;
      border-radius: 16px;
    }
    .tier-card.pro {
      background: linear-gradient(180deg, #0A0A0A 0%, #181818 100%);
      color: #F7F2EA;
      border-color: #0A0A0A;
    }
    .tier-card.pro .pill { background: rgba(255,255,255,0.06); border-color: rgba(255,255,255,0.16); color: #E7DECD; }
    .score-bar { height: 10px; background: #E7DECD; border-radius: 999px; overflow: hidden; }
    .score-bar > span { display: block; height: 100%; border-radius: 999px; }
    .compare-old > .score-bar > span { background: linear-gradient(90deg, #C9C2B3, #8C8472); }
    .compare-new > .score-bar > span { background: linear-gradient(90deg, #FF4D2E, #E63312); }
  </style>
</head>
<body class="antialiased">

  <!-- =================== HEADER BAR =================== -->
  <header class="bg-ink text-white">
    <div class="max-w-7xl mx-auto px-6 py-3.5 flex items-center justify-between gap-4">
      <a href="https://actiondesignstudio.com" class="flex items-center gap-2.5 group">
        <span class="w-8 h-8 rounded-md flex items-center justify-center" style="background: linear-gradient(135deg, #FF4D2E, #E63312);">
          <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12 L10 17 L19 7"></path>
          </svg>
        </span>
        <span class="font-heading font-bold text-[13px] tracking-[0.18em] uppercase">Action Studio</span>
      </a>
      <div class="flex items-center gap-3 text-right">
        <div class="hidden sm:block">
          <div class="text-[10px] tracking-[0.22em] text-white/55 uppercase font-semibold">Prepared exclusively for</div>
          <div class="font-heading font-bold text-sm uppercase tracking-wider">{{contractor_brand_name}}</div>
        </div>
        <div class="w-9 h-9 rounded-md bg-white/95 flex items-center justify-center overflow-hidden">
          <img src="{{contractor_logo_path}}" alt="{{contractor_brand_name}} logo" class="max-w-full max-h-full object-contain" onerror="this.style.display='none'" />
        </div>
      </div>
    </div>
  </header>

  <!-- =================== AI-PHOTO BANNER (name-and-reviews mode only) =================== -->
  {{#if_mode_name_and_reviews}}
  <div class="banner-ai">
    <div class="max-w-7xl mx-auto px-6 py-2.5 text-center text-[13px] font-medium">
      <span class="font-bold">Heads up:</span>
      This preview uses placeholder photography. Send us your real photos and we'll swap them in before launch.
    </div>
  </div>
  {{/if_mode_name_and_reviews}}

  <!-- =================== HERO =================== -->
  <section class="relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-6 pt-16 pb-12 lg:pt-24 lg:pb-16">
      <div class="flex flex-col gap-6 max-w-4xl">
        <div class="flex items-center gap-3">
          <span class="pill">Walkthrough · {{prepared_date}}</span>
          <span class="pill" style="background:#0A0A0A;color:#F7F2EA;border-color:#0A0A0A;">Private link</span>
        </div>
        <h1 class="font-heading text-[42px] sm:text-[56px] lg:text-[72px] leading-[0.98] font-bold text-ink">
          Here's why your website is leaving money on the table.
        </h1>
        <p class="text-lg lg:text-xl text-ink-mute leading-relaxed max-w-2xl">
          Three levers run every contractor website that actually books estimates: <strong class="text-ink">traffic, trust, and conversion.</strong>
          Pull all three and the math works every single time. We rebuilt yours so all three are pulling — here's the walkthrough.
        </p>
        <div class="flex flex-wrap gap-3 mt-2">
          <a href="{{site_preview_url}}" target="_blank" rel="noopener" class="cta-red inline-flex items-center gap-2 px-7 py-4 rounded-xl font-heading font-bold uppercase tracking-wider text-[15px]">
            View Your Website
            <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M7 17 L17 7"></path>
              <path d="M8 7 H17 V16"></path>
            </svg>
          </a>
          <a href="#formula" class="inline-flex items-center gap-2 px-7 py-4 rounded-xl font-heading font-bold uppercase tracking-wider text-[15px] border border-ink/20 hover:bg-ink hover:text-cream transition">
            See the formula
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- =================== OPPORTUNITY =================== -->
  <section class="bg-cream-2/60">
    <div class="max-w-5xl mx-auto px-6 py-16 lg:py-20">
      <div class="text-[11px] tracking-[0.3em] uppercase font-bold text-as-red mb-4">The opportunity</div>
      <p class="font-heading text-2xl lg:text-3xl leading-snug text-ink font-semibold">
        {{opportunity_summary}}
      </p>
    </div>
  </section>

  <!-- =================== THE WINNING FORMULA =================== -->
  <section id="formula" class="py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-3xl">
        <div class="text-[11px] tracking-[0.3em] uppercase font-bold text-as-red mb-4">The winning formula</div>
        <h2 class="font-heading text-[40px] lg:text-[56px] leading-[1.02] font-bold text-ink">
          Three levers. Pull all three and the math works every time.
        </h2>
        <p class="text-lg text-ink-mute mt-5 max-w-2xl">
          Every contractor we audit is missing at least one of these. Most are missing two. Your new site pulls all three.
        </p>
      </div>

      <div class="mt-12 flex justify-center">
        <a href="{{site_preview_url}}" target="_blank" rel="noopener" class="cta-red inline-flex items-center gap-3 px-8 py-4 rounded-xl font-heading font-bold uppercase tracking-wider text-[15px]">
          View the ultimate roofing website blueprint
          <span class="text-base">&#128274;</span>
        </a>
      </div>

      <div class="grid md:grid-cols-3 gap-6 mt-14">

        <!-- LEVER 01 — TRAFFIC -->
        <article class="lever-card p-7">
          <div class="flex items-baseline justify-between">
            <span class="num-display text-[64px] leading-none">01</span>
            <span class="pill">Lever 1</span>
          </div>
          <h3 class="font-heading text-xl font-bold mt-4 uppercase tracking-wide text-ink">Traffic</h3>
          <p class="font-heading text-2xl font-semibold leading-snug mt-1 text-ink">Get found first on Google + AI.</p>
          <p class="text-ink-mute mt-3 text-[15px] leading-relaxed">
            The customer types the search. You either show up first or you don't exist to them.
          </p>
          <details class="mt-5 group">
            <summary class="inline-flex items-center gap-2 font-heading font-bold uppercase tracking-wider text-xs text-as-red">
              How?
              <svg class="how-chev w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 9 L12 15 L18 9"></path>
              </svg>
            </summary>
            <div class="mt-4 text-[15px] leading-relaxed text-ink-soft space-y-3">
              <p>
                The old playbook was rank for one keyword in one city. The new playbook is rank for every variation of every service, in every neighborhood you serve, on Google search, on Google Maps, and inside ChatGPT and Perplexity when someone asks "best roofer near me." Three different surfaces, one set of pages built right.
              </p>
              <p>
                Your new site has a dedicated landing page for every service you offer, optimized for the exact phrases your customers type. Service-area pages for every town you cover. Schema markup so Google Maps and AI assistants both surface you. Real review text Google can crawl, not screenshots locked in an image. Page speed and mobile core web vitals tuned green so Google ranks you above the slow guy.
              </p>
              <p class="font-semibold text-ink">Outcome: more right-fit phones ringing. Not bigger numbers in a dashboard.</p>
            </div>
          </details>
        </article>

        <!-- LEVER 02 — TRUST -->
        <article class="lever-card p-7">
          <div class="flex items-baseline justify-between">
            <span class="num-display text-[64px] leading-none">02</span>
            <span class="pill">Lever 2</span>
          </div>
          <h3 class="font-heading text-xl font-bold mt-4 uppercase tracking-wide text-ink">Trust</h3>
          <p class="font-heading text-2xl font-semibold leading-snug mt-1 text-ink">Win them in 5 seconds.</p>
          <p class="text-ink-mute mt-3 text-[15px] leading-relaxed">
            The visitor decides in the first scroll whether you're real. Make the answer obvious.
          </p>
          <details class="mt-5 group">
            <summary class="inline-flex items-center gap-2 font-heading font-bold uppercase tracking-wider text-xs text-as-red">
              How?
              <svg class="how-chev w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 9 L12 15 L18 9"></path>
              </svg>
            </summary>
            <div class="mt-4 text-[15px] leading-relaxed text-ink-soft space-y-3">
              <p>
                People hire contractors who feel like a known quantity inside five seconds. The signals that close that gap are surprisingly consistent: a real owner's face, a real star rating with a real count, a real local address, real project photos of actual jobs, and real certifications that link to the issuing body. The opposite — stock photos, vague "trusted by hundreds" claims, no owner anywhere on the site — is what makes good contractors look like fly-by-night.
              </p>
              <p>
                Your new homepage front-loads every trust signal we could pull from your real online presence. Your Google rating and review count, the owner's name and photo, your license number, your service area on a map, your real recent projects. No stock. No filler. By the time the visitor scrolls past the hero, they've already decided you're real.
              </p>
              <p class="font-semibold text-ink">Outcome: the visitor stops shopping and starts asking when you can come out.</p>
            </div>
          </details>
        </article>

        <!-- LEVER 03 — CONVERSION -->
        <article class="lever-card p-7">
          <div class="flex items-baseline justify-between">
            <span class="num-display text-[64px] leading-none">03</span>
            <span class="pill">Lever 3</span>
          </div>
          <h3 class="font-heading text-xl font-bold mt-4 uppercase tracking-wide text-ink">Conversion</h3>
          <p class="font-heading text-2xl font-semibold leading-snug mt-1 text-ink">Turn visits into booked estimates.</p>
          <p class="text-ink-mute mt-3 text-[15px] leading-relaxed">
            Traffic without conversion is just a hosting bill. The site has to do the asking.
          </p>
          <details class="mt-5 group">
            <summary class="inline-flex items-center gap-2 font-heading font-bold uppercase tracking-wider text-xs text-as-red">
              How?
              <svg class="how-chev w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 9 L12 15 L18 9"></path>
              </svg>
            </summary>
            <div class="mt-4 text-[15px] leading-relaxed text-ink-soft space-y-3">
              <p>
                A great contractor site behaves like your best salesperson — present on every page, never pushy, always one click away. The visitor should never have to hunt for how to contact you, never have to guess what you charge for a typical job, and never feel like they're filling out a tax return just to ask a question.
              </p>
              <p>
                Your new site has a quote form pinned to the hero on every page, a tap-to-call button stuck to the bottom of every mobile screen, a short three-field form that doesn't scare anyone off, and a clear price band so visitors self-qualify before they call. Pages are tuned for the smallest screens first, because that's where the leads actually come from. Forms post to your inbox the second they're submitted.
              </p>
              <p class="font-semibold text-ink">Outcome: more booked estimates from the same traffic. Same ad spend, more revenue.</p>
            </div>
          </details>
        </article>

      </div>
    </div>
  </section>

  <!-- =================== THE PROOF =================== -->
  <section class="bg-cream-2/60 py-20 lg:py-24">
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-3xl">
        <div class="text-[11px] tracking-[0.3em] uppercase font-bold text-as-red mb-4">The proof — real evidence on your new site</div>
        <h2 class="font-heading text-[36px] lg:text-[48px] leading-[1.04] font-bold text-ink">
          Every claim, traceable to a real source.
        </h2>
      </div>

      <div class="grid md:grid-cols-3 gap-6 mt-12">

        <div class="bg-cream rounded-2xl p-7 border border-ink/8">
          <div class="text-[11px] tracking-[0.3em] uppercase font-bold text-as-red">Reviews proof</div>
          <p class="font-heading text-3xl font-bold text-ink mt-4 leading-tight">
            {{review_count}} verified Google reviews, {{review_rating}}&#9733; average.
          </p>
          <p class="text-ink-mute mt-3 text-[15px] leading-relaxed">
            Every one is on your new site. Names, dates, star counts — all pulled from Google, none manufactured.
          </p>
        </div>

        <div class="bg-cream rounded-2xl p-7 border border-ink/8">
          <div class="text-[11px] tracking-[0.3em] uppercase font-bold text-as-red">Photos proof</div>
          <p class="font-heading text-3xl font-bold text-ink mt-4 leading-tight">
            {{photo_count}} of your real project photos.
          </p>
          <p class="text-ink-mute mt-3 text-[15px] leading-relaxed">
            No stock, no generic, your work. {{#if_mode_name_and_reviews}}<em class="text-ink-mute/80">Placeholders shown today — we swap in your real photos before launch.</em>{{/if_mode_name_and_reviews}}
          </p>
        </div>

        <div class="bg-cream rounded-2xl p-7 border border-ink/8">
          <div class="text-[11px] tracking-[0.3em] uppercase font-bold text-as-red">Local SEO proof</div>
          <p class="font-heading text-3xl font-bold text-ink mt-4 leading-tight">
            Built for &ldquo;{{primary_keyword}}.&rdquo;
          </p>
          <p class="text-ink-mute mt-3 text-[15px] leading-relaxed">
            The exact search your customers actually type. Pages, schema, and titles all tuned for it.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- =================== WHAT YOU'RE GETTING =================== -->
  <section class="py-20 lg:py-24">
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-3xl">
        <div class="text-[11px] tracking-[0.3em] uppercase font-bold text-as-red mb-4">What you're getting</div>
        <h2 class="font-heading text-[36px] lg:text-[48px] leading-[1.04] font-bold text-ink">
          The full build. Live. Yours.
        </h2>
      </div>

      <ul class="mt-10 grid md:grid-cols-2 gap-x-10 gap-y-4 max-w-5xl">
        <li class="flex items-start gap-3 text-[15px] text-ink-soft leading-relaxed">
          <span class="check-dot mt-1">&#10003;</span>
          <span><strong class="text-ink">A multi-page site</strong> — home, about, services index, a detail page per service, reviews, and contact. All linked, all crawlable.</span>
        </li>
        <li class="flex items-start gap-3 text-[15px] text-ink-soft leading-relaxed">
          <span class="check-dot mt-1">&#10003;</span>
          <span><strong class="text-ink">Every word written for you</strong> — headlines, sub-headlines, service descriptions, FAQs, CTAs. In your voice, not agency-speak.</span>
        </li>
        <li class="flex items-start gap-3 text-[15px] text-ink-soft leading-relaxed">
          <span class="check-dot mt-1">&#10003;</span>
          <span><strong class="text-ink">Your real Google reviews embedded</strong> — text, stars, dates, on the reviews page and the homepage. Schema-marked so Google shows your rating in search.</span>
        </li>
        <li class="flex items-start gap-3 text-[15px] text-ink-soft leading-relaxed">
          <span class="check-dot mt-1">&#10003;</span>
          <span><strong class="text-ink">Mobile-first responsive</strong> — every breakpoint tested. Your phone, your customer's phone, the tablet on the kitchen counter.</span>
        </li>
        <li class="flex items-start gap-3 text-[15px] text-ink-soft leading-relaxed">
          <span class="check-dot mt-1">&#10003;</span>
          <span><strong class="text-ink">Local SEO baked in</strong> — title tags, meta descriptions, schema markup, internal links, sitemap.xml. Google reads you fluently.</span>
        </li>
        <li class="flex items-start gap-3 text-[15px] text-ink-soft leading-relaxed">
          <span class="check-dot mt-1">&#10003;</span>
          <span><strong class="text-ink">A working quote form</strong> — three fields, no friction, posts straight to your inbox.</span>
        </li>
        <li class="flex items-start gap-3 text-[15px] text-ink-soft leading-relaxed">
          <span class="check-dot mt-1">&#10003;</span>
          <span><strong class="text-ink">Click-to-call on mobile</strong> — sticky bar at the bottom of every mobile page. One tap, you're on the phone.</span>
        </li>
        <li class="flex items-start gap-3 text-[15px] text-ink-soft leading-relaxed">
          <span class="check-dot mt-1">&#10003;</span>
          <span><strong class="text-ink">QA audit report</strong> — 30+ pass/fail gates, every one documented, every one green before you saw this page.</span>
        </li>
        <li class="flex items-start gap-3 text-[15px] text-ink-soft leading-relaxed">
          <span class="check-dot mt-1">&#10003;</span>
          <span><strong class="text-ink">Hosted on a fast CDN</strong> — Vercel global edge, free SSL, sub-second load times worldwide.</span>
        </li>
        <li class="flex items-start gap-3 text-[15px] text-ink-soft leading-relaxed">
          <span class="check-dot mt-1">&#10003;</span>
          <span><strong class="text-ink">Source files, yours forever</strong> — you own the code, you own the content, you can move it any time.</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- =================== THE INVESTMENT =================== -->
  <section class="bg-cream-2/60 py-20 lg:py-24">
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-3xl">
        <div class="text-[11px] tracking-[0.3em] uppercase font-bold text-as-red mb-4">The investment</div>
        <h2 class="font-heading text-[36px] lg:text-[48px] leading-[1.04] font-bold text-ink">
          Two tiers. Pick the one that matches where you are.
        </h2>
        <p class="text-lg text-ink-mute mt-4 max-w-2xl">
          The standard tier is what you're looking at right now. The pro tier extends it with the things bigger contractors eventually need.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-6 mt-12 max-w-5xl">

        <article class="tier-card p-8">
          <div class="flex items-center justify-between">
            <span class="pill">Standard</span>
            {{#if_standard_tier}}<span class="pill" style="background:#0A0A0A;color:#F7F2EA;border-color:#0A0A0A;">Recommended</span>{{/if_standard_tier}}
          </div>
          <p class="font-heading text-5xl font-bold mt-4 text-ink">{{standard_tier_price}}</p>
          <p class="text-ink-mute mt-1 text-sm">one-time build, plus hosting</p>
          <ul class="mt-6 space-y-3 text-[15px] text-ink-soft">
            <li class="flex items-start gap-2.5"><span class="check-dot mt-0.5">&#10003;</span><span>Full multi-page build (home, about, services, reviews, contact)</span></li>
            <li class="flex items-start gap-2.5"><span class="check-dot mt-0.5">&#10003;</span><span>Per-service detail pages — fanned out from your services list</span></li>
            <li class="flex items-start gap-2.5"><span class="check-dot mt-0.5">&#10003;</span><span>Real Google reviews embedded and schema-marked</span></li>
            <li class="flex items-start gap-2.5"><span class="check-dot mt-0.5">&#10003;</span><span>Mobile-first responsive, fast on every device</span></li>
            <li class="flex items-start gap-2.5"><span class="check-dot mt-0.5">&#10003;</span><span>Local SEO baked in (titles, meta, schema, sitemap)</span></li>
            <li class="flex items-start gap-2.5"><span class="check-dot mt-0.5">&#10003;</span><span>Quote form posting to your inbox + tap-to-call on mobile</span></li>
            <li class="flex items-start gap-2.5"><span class="check-dot mt-0.5">&#10003;</span><span>Vercel hosting, free SSL, your domain</span></li>
          </ul>
        </article>

        <article class="tier-card pro p-8">
          <div class="flex items-center justify-between">
            <span class="pill">Pro</span>
            {{#if_pro_tier}}<span class="pill" style="background:linear-gradient(135deg,#FF4D2E,#E63312);color:#fff;border-color:transparent;">Recommended</span>{{/if_pro_tier}}
          </div>
          <p class="font-heading text-5xl font-bold mt-4 text-cream">{{pro_tier_price}}</p>
          <p class="text-cream/55 mt-1 text-sm">one-time build, plus hosting</p>
          <p class="text-cream/80 mt-5 text-[13px] uppercase tracking-[0.2em] font-bold">Everything in standard, plus</p>
          <ul class="mt-3 space-y-3 text-[15px] text-cream/85">
            <li class="flex items-start gap-2.5"><span class="check-dot mt-0.5">&#10003;</span><span>Service-area landing pages (one per town in your service radius)</span></li>
            <li class="flex items-start gap-2.5"><span class="check-dot mt-0.5">&#10003;</span><span>Project gallery with categorized filters</span></li>
            <li class="flex items-start gap-2.5"><span class="check-dot mt-0.5">&#10003;</span><span>Financing widget + before/after slider</span></li>
            <li class="flex items-start gap-2.5"><span class="check-dot mt-0.5">&#10003;</span><span>CMS-backed blog (you publish without touching code)</span></li>
            <li class="flex items-start gap-2.5"><span class="check-dot mt-0.5">&#10003;</span><span>Online booking + customer portal</span></li>
            <li class="flex items-start gap-2.5"><span class="check-dot mt-0.5">&#10003;</span><span>CRM integration to whatever you use today</span></li>
            <li class="flex items-start gap-2.5"><span class="check-dot mt-0.5">&#10003;</span><span>Quarterly SEO + content updates included</span></li>
          </ul>
        </article>

      </div>
    </div>
  </section>

  <!-- =================== SIDE-BY-SIDE COMPARISON =================== -->
  <section class="py-20 lg:py-24">
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-3xl">
        <div class="text-[11px] tracking-[0.3em] uppercase font-bold text-as-red mb-4">Side by side</div>
        <h2 class="font-heading text-[36px] lg:text-[48px] leading-[1.04] font-bold text-ink">
          Your current site vs. what we built.
        </h2>
        <p class="text-lg text-ink-mute mt-4 max-w-2xl">
          We scored both sites on the same 12-axis scorecard. 120 points possible. Here's where each lands.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-6 mt-12 max-w-5xl">

        <article class="compare-old bg-cream-2/40 rounded-2xl p-8 border border-ink/8">
          <div class="text-[11px] tracking-[0.3em] uppercase font-bold text-ink-mute">Your current site</div>
          <p class="font-heading text-7xl font-bold text-ink-mute mt-3 leading-none">{{old_site_score}}<span class="text-2xl text-ink-mute/60 font-medium">/120</span></p>
          <div class="score-bar mt-5"><span style="width: calc({{old_site_score}} * 100% / 120);"></span></div>
          <ul class="mt-6 space-y-2 text-[14px] text-ink-mute leading-relaxed">
            <li>&mdash; Missing trust signals above the fold</li>
            <li>&mdash; No per-service pages for Google or AI to crawl</li>
            <li>&mdash; Reviews are screenshots, not crawlable text</li>
            <li>&mdash; Mobile experience needs work</li>
          </ul>
        </article>

        <article class="compare-new bg-cream rounded-2xl p-8 border border-ink/10">
          <div class="text-[11px] tracking-[0.3em] uppercase font-bold text-as-red">What we built</div>
          <p class="font-heading text-7xl font-bold mt-3 leading-none num-display">{{new_site_score}}<span class="text-2xl font-medium" style="-webkit-text-fill-color:#0A0A0A;color:#0A0A0A;background:none;">/120</span></p>
          <div class="score-bar mt-5"><span style="width: calc({{new_site_score}} * 100% / 120);"></span></div>
          <ul class="mt-6 space-y-2 text-[14px] text-ink-soft leading-relaxed">
            <li>&mdash; Real owner, real reviews, real photos above the fold</li>
            <li>&mdash; A page per service, schema-marked, crawl-clean</li>
            <li>&mdash; Reviews as live text + JSON-LD for Google search</li>
            <li>&mdash; Mobile-first, sub-second load on phones</li>
          </ul>
        </article>

      </div>
    </div>
  </section>

  <!-- =================== CTA BAND =================== -->
  <section class="bg-ink text-cream py-20 lg:py-24">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <div class="text-[11px] tracking-[0.3em] uppercase font-bold text-as-red-2 mb-4">Ready to make it live?</div>
      <h2 class="font-heading text-[42px] lg:text-[56px] leading-[1.02] font-bold">
        One call. Cutover by next week.
      </h2>
      <p class="text-lg text-cream/70 mt-5 max-w-2xl mx-auto">
        We'll walk through the site together, answer anything, and point your domain at the new build the same week.
      </p>
      <div class="mt-9">
        <a href="{{calendar_url}}" class="cta-red inline-flex items-center gap-2.5 px-8 py-4 rounded-xl font-heading font-bold uppercase tracking-wider text-[15px]">
          Schedule the cutover call
          <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12 H19"></path>
            <path d="M13 6 L19 12 L13 18"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- =================== FOOTER =================== -->
  <footer class="bg-ink text-cream/60 border-t border-white/8">
    <div class="max-w-7xl mx-auto px-6 py-10 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-2.5">
        <span class="w-7 h-7 rounded-md flex items-center justify-center" style="background: linear-gradient(135deg, #FF4D2E, #E63312);">
          <svg viewBox="0 0 24 24" class="w-3.5 h-3.5" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12 L10 17 L19 7"></path>
          </svg>
        </span>
        <span class="font-heading font-bold text-[12px] tracking-[0.18em] uppercase text-cream">Action Studio</span>
      </div>
      <div class="text-[11px] tracking-wider uppercase">
        Walkthrough prepared {{prepared_date}} &middot; Private link &middot; Do not share
      </div>
      <div class="text-[11px] tracking-wider">
        &copy; Action Design Studio
      </div>
    </div>
  </footer>

</body>
</html>
